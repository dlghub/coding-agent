# 模型 API 密钥，真实值只能放在未提交的 .env 文件或环境变量中
AGENT_API_KEY=

# OpenAI-compatible API 地址
AGENT_BASE_URL=https://token.bayesdl.com/api/maas/v1

# 第三方平台提供的准确模型 ID
AGENT_MODEL=deepseek-v4-flash-ziyong

# 单次模型请求超时，单位为秒
AGENT_TIMEOUT=60

# Agent 最大循环步数
AGENT_MAX_STEPS=20

# 发送给模型的上下文字符预算；超出后压缩较早的完整工具回合
AGENT_MAX_CONTEXT_CHARS=120000

# 命令执行隔离。docker 为安全默认值；host 仅用于明确接受风险的兼容场景
AGENT_SANDBOX_MODE=docker

# 必须预先存在于本机，PatchPilot 不会自动拉取镜像
AGENT_SANDBOX_IMAGE=ubuntu:22.04
